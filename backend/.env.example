# Port du serveur Express
PORT=4000

# URL du micro-service Python du pipeline Spleeter principal
STEM_SERVICE_URL=http://localhost:8000

# Clé API AudD (https://dashboard.audd.io) — tier gratuit disponible
AUDD_API_TOKEN=your_audd_token_here

# URL publique du frontend (utilisée dans les liens de vérification)
FRONTEND_URL=http://localhost:5173

# SMTP : requis pour envoyer réellement les e-mails de vérification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Backline <noreply@example.com>"

# Compte administrateur local (à remplacer en production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_local_password

# LRCLIB (https://lrclib.net) ne nécessite pas de clé API


# Phone microphone: origins are exact, never a wildcard. Open PC and phone on
# the SAME HTTPS origin. For a Quick Tunnel, replace this each time it changes.
# Blank = FRONTEND_URL. Restart backend after changing.
PHONE_MIC_PUBLIC_URL=
PHONE_MIC_ALLOWED_ORIGINS=
PHONE_MIC_PAIRING_SECONDS=300
PHONE_MIC_SESSION_SECONDS=7200
PHONE_MIC_RECONNECT_SECONDS=45

# Comma-separated ICE URLs; STUN exchanges discovery metadata, not microphone audio.
# Empty works only on directly reachable networks. Configure explicitly for production.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# Your own/trusted coturn with use-auth-secret. No static TURN password in frontend.
WEBRTC_TURN_URLS=
WEBRTC_TURN_SECRET=
# Force relay only to verify TURN (leave false normally).
WEBRTC_RELAY_ONLY=false

# Le Défi: durée d’une invitation non acceptée (jours)
CHALLENGE_EXPIRY_DAYS=7
